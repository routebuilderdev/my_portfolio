---
export interface Props {
  title: string;
  slug: string;
  outcomeSummary: string;
  role: string;
  year: number;
  techStack: string[];
  featured?: boolean;
  status?: string;
  liveUrl?: string;
}

const { title, slug, outcomeSummary, role, year, techStack, featured, status, liveUrl } = Astro.props;
---

<a href={`/projects/${slug}`} class:list={['project-card', { 'project-card--featured': featured }]}>
  <div class="project-card-header">
    {featured && <span class="project-featured">Featured</span>}
    {liveUrl && <span class="project-live">Live</span>}
    {status && status !== 'completed' && <span class="project-status">{status}</span>}
  </div>
  <h3 class="project-title">{title}</h3>
  <p class="project-outcome">{outcomeSummary}</p>
  <div class="project-meta">
    <span>{role}</span>
    <span class="meta-sep">·</span>
    <span>{year}</span>
  </div>
  <div class="project-tags">
    {techStack.slice(0, 4).map((tech) => <span class="project-tag">{tech}</span>)}
    {techStack.length > 4 && <span class="project-tag">+{techStack.length - 4}</span>}
  </div>
</a>

<style>
  .project-card { display: block; padding: var(--space-xl); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); text-decoration: none; transition: border-color var(--transition-base), background var(--transition-base); }
  .project-card:hover { border-color: var(--color-text-muted); background: var(--color-bg-elevated); }
  .project-card--featured { border-color: var(--color-accent-muted); background: var(--gradient-card); }
  .project-card-header { display: flex; gap: var(--space-sm); margin-bottom: var(--space-sm); }
  .project-featured { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); }
  .project-live { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); border: 1px solid var(--color-accent-muted); border-radius: var(--border-radius-sm); padding: 0.125rem 0.375rem; }
  .project-status { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .project-title { font-size: var(--font-size-xl); font-weight: var(--font-weight-semibold); color: var(--color-text); margin-bottom: var(--space-sm); }
  .project-outcome { font-size: var(--font-size-base); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); margin-bottom: var(--space-md); }
  .project-meta { font-size: var(--font-size-sm); color: var(--color-text-muted); margin-bottom: var(--space-md); display: flex; gap: var(--space-sm); }
  .meta-sep { opacity: 0.5; }
  .project-tags { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .project-tag { font-size: 0.75rem; padding: 0.25rem 0.5rem; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); color: var(--color-text-muted); }
</style>
