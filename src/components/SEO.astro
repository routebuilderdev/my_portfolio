---
import { siteConfig } from '../config';

export interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  noSuffix?: boolean;
}

const { title, description, type = 'website', image, noSuffix } = Astro.props;
const siteTitle = noSuffix ? title : title;
const siteDesc = description || '';
const path = Astro.url.pathname;
const absUrl = new URL(path, siteConfig.url).toString();
const siteImage = image || '/og-image.png';
const absImage = new URL(siteImage, siteConfig.url).toString();
---

<>
  <title>{siteTitle}</title>
  <meta name="description" content={siteDesc} />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={siteDesc} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={absUrl} />
  <meta property="og:image" content={absImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={siteDesc} />
  <meta name="twitter:image" content={absImage} />
  <link rel="canonical" href={absUrl} />
</>
