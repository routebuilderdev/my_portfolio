---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
---

<BaseLayout>
  <SEO slot="head" title="404 - Page Not Found" description="The page you're looking for doesn't exist." type="website" />
  <main class="page-container" style="text-align: center; padding-top: 6rem;">
    <h1 style="font-size: 4rem; margin-bottom: 1rem;">404</h1>
    <p style="font-size: var(--font-size-lg); color: var(--color-text-secondary); margin-bottom: 2rem;">
      The page you're looking for doesn't exist.
    </p>
    <a href="/" class="btn-primary">Go Home</a>
  </main>
</BaseLayout>
