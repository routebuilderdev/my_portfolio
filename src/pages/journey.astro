---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../pages.config';

const allJourney = await getCollection('journey');
const sortedJourney = allJourney.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout>
  <SEO slot="head" title={pagesConfig.journey.title} description={pagesConfig.journey.description} type="website" />
  <main class="page-container">
    <header class="page-header">
      <h1 class="page-title">{pagesConfig.journey.heading}</h1>
      <p class="page-intro">{pagesConfig.journey.intro}</p>
    </header>
    {sortedJourney.length > 0 ? (
      <div class="journey-list">
        {sortedJourney.map((entry) => {
          const date = new Date(entry.data.date);
          const formattedDate = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
          return (
            <article class="journey-entry">
              <div class="journey-marker">
                <span class="journey-type">{entry.data.type}</span>
                <time class="journey-date">{formattedDate}</time>
              </div>
              <div class="journey-content">
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                {entry.data.skills && entry.data.skills.length > 0 && (
                  <div class="journey-skills">
                    {entry.data.skills.map((skill: string) => <span class="skill-tag">{skill}</span>)}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">No journey entries yet.</p>
    )}
  </main>
</BaseLayout>

<style>
  .journey-list { display: flex; flex-direction: column; gap: 0; position: relative; }
  .journey-list::before { content: ''; position: absolute; left: 140px; top: 0; bottom: 0; width: 1px; background: var(--color-border); }
  .journey-entry { display: flex; gap: var(--space-xl); padding: var(--space-xl) 0; border-bottom: 1px solid var(--color-border-subtle); }
  .journey-marker { width: 120px; flex-shrink: 0; text-align: right; padding-top: 0.25rem; }
  .journey-type { display: inline-block; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin-bottom: var(--space-sm); }
  .journey-date { display: block; font-size: var(--font-size-sm); color: var(--color-text-muted); }
  .journey-content { flex: 1; padding-left: var(--space-xl); }
  .journey-content h3 { font-size: var(--font-size-xl); font-weight: var(--font-weight-semibold); margin-bottom: var(--space-sm); }
  .journey-content p { font-size: var(--font-size-base); line-height: var(--line-height-relaxed); color: var(--color-text-secondary); margin-bottom: var(--space-md); }
  .journey-skills { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .skill-tag { font-size: 0.75rem; padding: 0.25rem 0.5rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); color: var(--color-text-muted); }
  @media (max-width: 768px) {
    .journey-list::before { left: 80px; }
    .journey-marker { width: 60px; }
    .journey-entry { gap: var(--space-md); }
    .journey-content { padding-left: var(--space-md); }
  }
</style>
