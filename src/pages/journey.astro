---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import PageStats from '../components/PageStats.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../pages.config';

const allJourney = await getCollection('journey');
const sortedJourney = allJourney.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const years = [...new Set(sortedJourney.map((entry) => new Date(entry.data.date).getFullYear()))];

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const formatDate = (date: Date) =>
  `${String(date.getUTCDate()).padStart(2, '0')} ${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;

const latestEntry = sortedJourney.length > 0 ? new Date(sortedJourney[0].data.date) : new Date();
const firstEntry = sortedJourney.length > 0 ? new Date(sortedJourney[sortedJourney.length - 1].data.date) : new Date();
const updated = new Date();
const range = `${firstEntry.toLocaleDateString('en-GB', { month: 'long' })}–${latestEntry.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}`;
---

<BaseLayout>
  <SEO slot="head" title={pagesConfig.journey.title} description={pagesConfig.journey.description} type="website" />
  <main class="page-container">
    <header class="page-header">
      <h1 class="page-title">{pagesConfig.journey.heading}</h1>
      <p class="page-intro">{pagesConfig.journey.intro}</p>
      <PageStats text={`${sortedJourney.length} entries · ${range} · updated ${formatDate(updated)}`} />
    </header>

    <section class="now-card" aria-labelledby="now-heading">
      <span class="now-label" id="now-heading">Now · {formatDate(updated)}</span>
      <p>
        Maintaining No Scratch Nav in production, contributing adapter fixes to
        <a href="/open-source">DefiLlama</a>, and submitted
        <a href="/projects/fine-print">Fine Print</a> to #BuildHybridAI 2026 in November.
        <a href="/projects/ship-confidence">Ship Confidence</a> and
        <a href="/projects/correlation">Correlation</a> are in the case studies. Open to full-stack and AI-platform roles in the EU and UK.
      </p>
    </section>

    {sortedJourney.length > 0 ? (
      years.map((year) => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <h2 class="year-label" id={`year-${year}`}>{year}</h2>
          <ol class="journey-list">
            {sortedJourney
              .filter((entry) => new Date(entry.data.date).getFullYear() === year)
              .map((entry) => {
                const date = new Date(entry.data.date);
                return (
                  <li class="journey-entry">
                    <div class="journey-marker">
                      <span class="journey-type">{entry.data.type}</span>
                      <time class="journey-date" datetime={date.toISOString()}>{formatDate(date)}</time>
                    </div>
                    <div class="journey-content">
                      <h3>{entry.data.title}</h3>
                      <p>{entry.data.description}</p>
                      {entry.data.skills && entry.data.skills.length > 0 && (
                        <div class="journey-skills">
                          {entry.data.skills.map((skill: string) => <span class="skill-tag">{skill}</span>)}
                        </div>
                      )}
                    </div>
                  </li>
                );
              })}
          </ol>
        </section>
      ))
    ) : (
      <p class="empty-state">No journey entries yet.</p>
    )}
  </main>
</BaseLayout>

<style>
  .now-card { max-width: 680px; padding: 1.25rem 1.5rem; margin-bottom: var(--space-3xl); background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius-md); }
  .now-label { display: block; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin-bottom: var(--space-sm); }
  .now-card p { font-size: var(--font-size-sm); line-height: var(--line-height-relaxed); color: var(--color-text-secondary); }
  .now-card a { color: var(--color-text); text-decoration: underline; text-decoration-color: var(--color-border); text-underline-offset: 3px; }
  .now-card a:hover { color: var(--color-accent); }
  .year-group { margin-bottom: var(--space-2xl); }
  .year-label { font-size: var(--font-size-sm); font-weight: 600; letter-spacing: 0.08em; color: var(--color-text-muted); text-transform: uppercase; padding-bottom: var(--space-md); border-bottom: 1px solid var(--color-border); margin-bottom: 0; }
  .journey-list { list-style: none; margin: 0; padding: 0; position: relative; }
  .journey-list::before { content: ''; position: absolute; left: 150px; top: 0; bottom: 0; width: 1px; background: var(--color-border); }
  .journey-entry { display: flex; gap: var(--space-xl); padding: var(--space-xl) 0; border-bottom: 1px solid var(--color-border-subtle); }
  .journey-entry:last-child { border-bottom: none; }
  .journey-marker { width: 130px; flex-shrink: 0; text-align: right; padding-top: 0.2rem; }
  .journey-type { display: inline-block; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent); margin-bottom: var(--space-xs); }
  .journey-date { display: block; font-size: var(--font-size-sm); color: var(--color-text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .journey-content { flex: 1; padding-left: var(--space-xl); }
  .journey-content h3 { font-size: var(--font-size-xl); font-weight: var(--font-weight-semibold); margin-bottom: var(--space-sm); line-height: 1.3; }
  .journey-content p { font-size: var(--font-size-base); line-height: var(--line-height-relaxed); color: var(--color-text-secondary); margin-bottom: var(--space-md); }
  .journey-skills { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .skill-tag { font-size: 0.75rem; padding: 0.25rem 0.5rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: var(--border-radius-sm); color: var(--color-text-muted); }
  @media (max-width: 768px) {
    .journey-list::before { left: 0; }
    .journey-entry { flex-direction: column; gap: var(--space-sm); padding-left: var(--space-md); }
    .journey-marker { width: auto; text-align: left; display: flex; align-items: baseline; gap: var(--space-sm); }
    .journey-type { margin-bottom: 0; }
    .journey-content { padding-left: 0; }
  }
</style>
