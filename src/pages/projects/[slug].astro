---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import SEO from '../../components/SEO.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<CaseStudyLayout>
  <SEO slot="head" title={`${data.title} - ${siteConfig.title}`} description={data.outcomeSummary} type="article" />
  <div class="case-study-header">
    <h1>{data.title}</h1>
    <div class="case-study-meta">
      <span>{data.role}</span>
      <span class="meta-separator">·</span>
      <span>{data.year}</span>
      {data.duration && <><span class="meta-separator">·</span><span>{data.duration}</span></>}
      {data.teamSize && <><span class="meta-separator">·</span><span>Team of {data.teamSize}</span></>}
    </div>
    <p class="outcome-summary">{data.outcomeSummary}</p>
    {data.repo && (
      <a href={data.repo} target="_blank" rel="noopener noreferrer" class="btn-secondary repo-link">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        View Source on GitLab
      </a>
    )}
    {data.liveUrl && (
      <a href={data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary repo-link">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 1a3.5 3.5 0 0 1 3.5 3.5c0 .61-.16 1.19-.44 1.7L14.6 9.75c.27.26.43.63.4 1.03-.04.5-.4.92-.89 1.07l-3.4.98c-.34.1-.71.03-1-.18L8.28 10.5c-.09.1-.18.19-.28.27v3.23c0 .55-.45 1-1 1s-1-.45-1-1v-3.23c-.1-.08-.19-.17-.28-.27l-1.44 1.15c-.29.21-.66.28-1 .18l-3.4-.98c-.49-.15-.85-.57-.89-1.07-.03-.4.13-.77.4-1.03l3.54-3.55a3.48 3.48 0 0 1-.45-1.7A3.5 3.5 0 0 1 8 1zm0 1.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
        </svg>
        View Live App
      </a>
    )}
  </div>

  <div class="case-study-section">
    <h2>Overview</h2>
    <p>{data.overview}</p>
  </div>

  <div class="case-study-section">
    <h2>The Problem</h2>
    <p>{data.problem}</p>
  </div>

  <div class="case-study-section">
    <h2>Constraints</h2>
    <ul class="constraints-list">
      {data.constraints.map((c: string) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="case-study-section">
    <h2>Approach</h2>
    <p>{data.approach}</p>
  </div>

  <div class="case-study-section">
    <h2>Key Decisions</h2>
    <div class="decisions-list">
      {data.keyDecisions.map((kd: any) => (
        <div class="decision-item">
          <div class="decision-title">{kd.decision}</div>
          <div class="decision-reasoning">
            <strong>Reasoning</strong>
            <p>{kd.reasoning}</p>
          </div>
          {kd.alternatives && kd.alternatives.length > 0 && (
            <div class="decision-alternatives">
              <strong>Alternatives Considered</strong>
              <ul>
                {kd.alternatives.map((alt: string) => <li>{alt}</li>)}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="case-study-section">
    <h2>Tech Stack</h2>
    <ul class="tech-stack-list">
      {data.techStack.map((tech: string) => <li>{tech}</li>)}
    </ul>
  </div>

  <div class="case-study-section">
    <h2>Impact</h2>
    {data.impact.metrics && data.impact.metrics.length > 0 && (
      <div class="impact-metrics">
        {data.impact.metrics.map((m: any) => (
          <div class="metric-item">
            <div class="metric-value">{m.value}</div>
            <div class="metric-label">{m.label}</div>
          </div>
        ))}
      </div>
    )}
    <p class="impact-qualitative">{data.impact.qualitative}</p>
  </div>

  <div class="case-study-section">
    <h2>Key Learnings</h2>
    <ul class="learnings-list">
      {data.learnings.map((l: string) => <li>{l}</li>)}
    </ul>
  </div>

  {Content && (
    <div class="case-study-content">
      <Content />
    </div>
  )}
</CaseStudyLayout>
